{
  "_comment": "AOG Knowledge Base · Staging CloudBase v2 部署配置 (NJX 7/29 严令 staging 隔离)",
  "_isolated_from_production": true,
  "_first_phase_use_default_domain": "第一轮 staging 使用 CloudBase 默认域名, 不配自定义 CNAME. CNAME 是远端验收通过后的可选项, 非当前 PR 必填 (见 STAGING_ISOLATION_SPEC.md §2).",
  "_denylist_source": "ops/production-resource-denylist.json (仅作 denylist reference, 严禁 staging 引用)",
  "version": "2.0",
  "envId": "{{env.TCB_ENV_ID}}",
  "functionRoot": "./aog-web/functions",
  "functions": [
    {
      "name": "aog-api-staging",
      "runtime": "Python3.11",
      "handler": "scf_bootstrap.main_handler",
      "memorySize": 256,
      "timeout": 30,
      "installDependency": true,
      "triggers": [],
      "envVariables": [
        {"key": "ENVIRONMENT", "value": "staging"},
        {"key": "ALLOW_MOCK", "value": "false"},
        {"key": "STRICT_LLM", "value": "true"},
        {"key": "SYNC_ENABLED", "value": "false"},
        {"key": "APP_COMMIT_SHA", "value": "{{env.APP_COMMIT_SHA}}"},
        {"key": "MINIMAX_API_KEY", "value": "{{env.MINIMAX_API_KEY}}"},
        {"key": "MINIMAX_BASE_URL", "value": "{{env.MINIMAX_BASE_URL}}"},
        {"key": "MINIMAX_MODEL", "value": "{{env.MINIMAX_MODEL}}"},
        {"key": "CHROMA_PATH", "value": "{{env.CHROMA_PATH}}"},
        {"key": "SQLITE_PATH", "value": "{{env.SQLITE_PATH}}"},
        {"key": "FTS5_PATH", "value": "{{env.FTS5_PATH}}"},
        {"key": "RAG_BACKEND", "value": "{{env.RAG_BACKEND}}"},
        {"key": "LOG_LEVEL", "value": "{{env.LOG_LEVEL}}"}
      ]
    }
  ]
}
