# AOG Knowledge Base · Staging 环境变量模板 (NJX 7/29 严令)
#
# 用法:
#   1. cp .env.staging.example .env.staging
#   2. NJX 在 CloudBase staging env 单独配, 不复用 production 凭据
#   3. 所有 xxx-STAGING-PLACEHOLDER-xxx 占位符必须由 NJX 替换
#   4. CI staging-validation.yml 跑 denylist grep 验证本文件不引用 production 凭据
#
# 严禁: 复用 production MINIMAX_API_KEY / COS_SECRET_ID / COS_SECRET_KEY / FTS5_PATH / SQLITE_PATH
# 严禁: 引用 production envId / function / bucket / domain
#
# NJX 7/29: 第一轮 staging 用 CloudBase 默认域名, 不配自定义 CNAME
#           严禁 staging 文档/脚本中出现 production 4 项字面量 (envId / function / bucket / domain)

# ===== CloudBase 部署 (CloudBase v2 标准 env vars) =====
# TCB_ENV_ID 来自 CloudBase 控制台创建独立 staging env 后获取 (NJX 物理操作)
TCB_ENV_ID=xxx-STAGING-PLACEHOLDER-xxx
APP_COMMIT_SHA=xxx-STAGING-MERGE-SHA-xxx

# ===== LLM (staging 独立凭据, 不复用 production) =====
MINIMAX_API_KEY=xxx-STAGING-PLACEHOLDER-xxx
MINIMAX_BASE_URL=https://api.MiniMax.chat/v1
MINIMAX_MODEL=minimax-m3

# ===== 运行时 (强制 staging 模式) =====
ENVIRONMENT=staging
ALLOW_MOCK=false
STRICT_LLM=true
SYNC_ENABLED=false
LOG_LEVEL=INFO

# ===== 存储路径 (staging 独立路径, 严禁指向 production bucket) =====
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/aog.db
FTS5_PATH=./data/fts5_index.db
RAG_BACKEND=fts5
SYNC_STATE_DB_PATH=./data/sync_state.db

# ===== 知识库源 (staging 独立, 见 cloudbaserc.staging.json 部署配置) =====
KNOWLEDGE_BASE_PATH=/tmp/staging-kb
RAW_PATH=/tmp/staging-raw
# 第一轮 staging 用 CloudBase 默认域名 (NJX 7/29), 自定义 CNAME 是远端验收通过后的可选项
CORS_ALLOW_ORIGINS=http://localhost:3000

# ===== CloudBase 凭据 (staging 独立, 严禁 production COS_SECRET_ID) =====
# 严禁填入 production 的 COS_SECRET_ID / COS_SECRET_KEY
COS_BUCKET=xxx-STAGING-BUCKET-xxx
COS_REGION=ap-shanghai
COS_SECRET_ID=xxx-STAGING-SECRET-ID-xxx
COS_SECRET_KEY=xxx-STAGING-SECRET-KEY-xxx
