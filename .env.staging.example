# AOG Knowledge Base · Staging 环境变量模板 (NJX 7/30 PR #3 runtime preflight)
#
# 用法:
#   1. cp .env.staging.example .env.staging (本地开发用, .env.staging 在 .gitignore)
#   2. NJX 在 CloudBase staging env 单独配, 不复用 production 凭据
#   3. 所有 xxx-STAGING-PLACEHOLDER-xxx 占位符必须由 NJX 替换
#   4. CI staging-validation.yml 跑 denylist grep 验证本文件不引用 production 凭据
#   5. deploy-staging.sh 部署前拒绝 tracked .env.staging (NJX 7/30 secret safety 严令)
#
# 严禁: 复用 production MINIMAX_API_KEY / COS_SECRET_ID / COS_SECRET_KEY / FTS5_PATH / SQLITE_PATH
# 严禁: 引用 production envId / function / bucket / domain
#
# NJX 7/30 严令 data paths: FTS5_PATH / SQLITE_PATH / AOG_DB_PATH / CHROMA_PATH / SYNC_STATE_DB_PATH 全 /tmp
# NJX 7/29: 第一轮 staging 用 CloudBase 默认域名, 不配自定义 CNAME
# NJX 7/30: JWT_SECRET 至少 32 bytes

# ===== CloudBase 部署 (CloudBase v2 标准 env vars) =====
# TCB_ENV_ID 来自 CloudBase 控制台创建独立 staging env 后获取 (NJX 物理操作)
TCB_ENV_ID=xxx-STAGING-PLACEHOLDER-xxx
APP_COMMIT_SHA=xxx-STAGING-MERGE-SHA-xxx

# ===== LLM (staging 独立凭据, 不复用 production) =====
MINIMAX_API_KEY=xxx-STAGING-PLACEHOLDER-xxx
MINIMAX_BASE_URL=https://api.MiniMax.chat/v1
MINIMAX_MODEL=minimax-m3

# ===== 运行时 (强制 staging 模式) =====
ENVIRONMENT=staging
ALLOW_MOCK=false
STRICT_LLM=true
SYNC_ENABLED=false
LOG_LEVEL=INFO

# ===== 存储路径 (NJX 7/30 严令全 /tmp, 严禁指向 production bucket) =====
CHROMA_PATH=/tmp/chroma
SQLITE_PATH=/tmp/aog.db
FTS5_PATH=/tmp/fts5_index.db
AOG_DB_PATH=/tmp/aog.db
RAG_BACKEND=fts5
SYNC_STATE_DB_PATH=/tmp/sync_state.db
KNOWLEDGE_BASE_PATH=/tmp/staging-kb
RAW_PATH=/tmp/staging-raw

# ===== Auth (Sprint A · NJX 7/30 部署必填) =====
# AOG_VIEW_PASSWORD: admin/staff 共享 password, staging 独立 (不复用 production)
AOG_VIEW_PASSWORD=xxx-STAGING-PLACEHOLDER-xxx
# JWT_SECRET: 至少 32 bytes, staging 独立 (不复用 production)
# 生成: openssl rand -hex 32 (NJX 物理执行)
JWT_SECRET=xxx-STAGING-JWT-SECRET-MUST-BE-AT-LEAST-32-BYTES-LONG-xxx

# ===== 托管域名 (staging 独立, 第一轮用 CloudBase 默认域名) =====
# STAGING_HOSTING_ORIGIN: CORS 白名单用, 远端验收通过后 (可选) 改为自定义 CNAME
STAGING_HOSTING_ORIGIN=xxx-STAGING-PLACEHOLDER-xxx
CORS_ALLOW_ORIGINS=http://localhost:3000

# ===== CloudBase 凭据 (staging 独立, 严禁 production COS_SECRET_ID) =====
# 严禁填入 production 的 COS_SECRET_ID / COS_SECRET_KEY
COS_BUCKET=xxx-STAGING-BUCKET-xxx
COS_REGION=ap-shanghai
COS_SECRET_ID=xxx-STAGING-SECRET-ID-xxx
COS_SECRET_KEY=xxx-STAGING-SECRET-KEY-xxx
