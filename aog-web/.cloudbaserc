# CloudBase 用户级配置（私有，不 commit 真实 env_id / secret）
# 复制为 ~/.cloudbaserc 或本目录 .cloudbaserc（已在 .gitignore）

# 实际填入 NJX 自己的 envId（从 console.cloud.tencent.com/tcb 获取）
envId = "REPLACE_WITH_REAL_ENV_ID"

# 可选：访问密钥（如果使用本地 tcb CLI 部署时需要；CloudBase Run 容器运行时
# 推荐用环境变量 COS_SECRET_ID / COS_SECRET_KEY 而非写在配置文件里）
# secretId = "AKIDxxx"
# secretKey = "xxx"
