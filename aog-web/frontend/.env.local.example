# 后端 API 基础地址 (CONTRACT §2) — P0-2 规范 (2026-07-29)
#
# ★ 唯一规范: base URL 不带尾 /api, 路径由 endpoint 负责加 /api
#   错误: NEXT_PUBLIC_API_BASE=https://...com/api  → 实际请求 https://...com/api/api/cities (double-prefix 400)
#   正确: NEXT_PUBLIC_API_BASE=https://...com      → 实际请求 https://...com/api/cities
#
# 验证 (P0-2):
#   curl -sS "${NEXT_PUBLIC_API_BASE}/api/health" → 200
#   curl -sS "${NEXT_PUBLIC_API_BASE}/api/cities" → 200
#   curl -sS "${NEXT_PUBLIC_API_BASE}/api/api/cities" → 404 (确认 path 不会双拼)
#
# 开发：FastAPI 在 :8000 (详见 worktrees/backend)
# 生产：CloudBase SCF URL
NEXT_PUBLIC_API_BASE=http://localhost:8000
