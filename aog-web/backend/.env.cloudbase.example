# AOG AI 知识库 · CloudBase Run 生产环境变量模板
#
# 这是 NJX 在 CloudBase Run 控制台 "环境变量" 字段填入的内容 (一行 KEY=VALUE).
# .env.cloudbase.example 不 commit 真实 SecretId/Key, 只放结构和占位.
# 实际填值由 NJX 在控制台输入, 不入 git.
#
# ★ P0-3 治本 (2026-07-26): 必填项 4 个 (MINIMAX_API_KEY + COS_SECRET_ID + COS_SECRET_KEY + CORS)
#   NJX 余额到位后 5 步 deploy 流程:
#     1) 登录 https://console.cloud.tencent.com/tcb (NJX 物理 click)
#     2) 选 envId njx-copilot-d6gs7642f8fa17122 → CloudBase Run → aog-api 服务
#     3) 服务配置 → 环境变量 → 把下面 4 个 __FILL_AT_CLOUDBASE_CONSOLE__ 替换成真值
#        (真值在 NJX 1Password / .env.local, 详见 aog-web/docs/DEPLOY_CLOUDBASE.md)
#     4) PM 跑 `tcb fn deploy aog-api` 重新部署
#     5) PM curl 验证 /api/health + /api/cities 返 200

# ===== LLM (MiniMax M3) =====
# 必填. 缺失时后端会降级为 Mock LLM, 生产环境务必填真实 key.
# 真值 NJX 在 1Password / 本地 .env 找, 不入 git
MINIMAX_API_KEY=__FILL_AT_CLOUDBASE_CONSOLE__
MINIMAX_BASE_URL=https://api.MiniMax.chat/v1
MINIMAX_MODEL=minimax-m3

# ===== RAG (★ P0-3 加) =====
# ★ 生产必须 fts5: chromadb 无 Linux wheel, SCF 容器装不上
# FTS5 db 27MB 由 PM 本地跑 `cd aog-web/pipeline && python -m scripts.export_fts5` 生成
# 再 `python -m scripts.sync_to_cos` 上传到 COS 桶 (跟 chroma 一样路径)
RAG_BACKEND=fts5
FTS5_PATH=/app/aog-web/backend/data/fts5_index.db

# ===== 存储路径 (容器内绝对路径, 跟 Dockerfile 配套) =====
# CloudBase Run 把 COS 桶挂到 /app/aog-web/backend/data, 所以写绝对路径最稳.
# (CHROMA_PATH 已废, 但保留兼容旧代码: chroma 可选, fts5 必须)
CHROMA_PATH=/app/aog-web/backend/data/chroma
SQLITE_PATH=/app/aog-web/backend/data/aog.db
SYNC_STATE_DB_PATH=/app/aog-web/backend/data/sync_state.db

# ===== COS 凭证 (从 CAM 子账号获取, 最小权限: COS 读写 aog-prod-data 桶) =====
# ★ 必填 - 容器冷启动时用这些凭证从 COS 下载 chroma + aog.db
# 真值 NJX 在 1Password / 本地 .env 找, 不入 git
COS_BUCKET=aog-prod-data-1343051603
COS_REGION=ap-shanghai
COS_SECRET_ID=__FILL_AT_CLOUDBASE_CONSOLE__
COS_SECRET_KEY=__FILL_AT_CLOUDBASE_CONSOLE__

# ===== 数据源 (生产环境) =====
# 生产环境的知识库只读路径 — 注意 CloudBase Run 容器是临时文件系统,
# 这两个目录必须先打包到镜像里, 或者在容器启动时从 COS 同步.
# v1: 我们不打进镜像 (chroma 数据已经在 COS), 仅留作兼容旧代码.
#     如果未来想直接读源, 改成 s3://bucket/raw-data/... 或预打包.
KNOWLEDGE_BASE_PATH=/app/data/AOG知识库
RAW_PATH=/app/data/RAW

# ===== 运行时 =====
# 关闭增量同步 (CloudBase Run 容器临时, 多实例并发会冲突; 数据变更走本地 build + sync_to_cos)
SYNC_ENABLED=false
SYNC_INTERVAL_S=300
LOG_LEVEL=INFO

# ===== CORS (允许 CloudBase 静态托管域名 + 公网域名) =====
# ★ 部署后必填 - 把 <your-static-hosting-domain> 替换成实际分配/绑定的域名
# 格式: https://<envId>.app.tcloudbase.com  或  https://aog.njx.com
CORS_ALLOW_ORIGINS=https://__FILL_AT_CLOUDBASE_CONSOLE__.app.tcloudbase.com,https://aog.njx.com

# ===== 端口 (CloudBase Run 强制要求) =====
PORT=8000
PYTHONUNBUFFERED=1
