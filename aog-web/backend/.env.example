# AOG AI 知识库 · Backend 环境变量模板
# 复制为 .env 并填入实际值；.env 已在 .gitignore

# ===== LLM (MiniMax M3) =====
# 必填. 缺失时后端会降级为 Mock LLM (带 "⚠️ Mock 模式" 标志)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.MiniMax.chat/v1
MINIMAX_MODEL=minimax-m3

# ===== 存储 =====
# 向量库 (Chroma 持久化目录)
CHROMA_PATH=./data/chroma
# 元数据 (SQLite 数据库文件)
SQLITE_PATH=./data/aog.db

# ===== 知识库源 (只读) =====
# 城市预案 / 经验 / 核心预案根目录
KNOWLEDGE_BASE_PATH=/Users/njx/Project/AOG知识库/AOG知识库
# 原始文件下载代理源
RAW_PATH=/Users/njx/Project/AOG知识库/RAW

# ===== 运行时 =====
# 文件同步间隔 (秒)
SYNC_INTERVAL_S=300
# 日志级别
LOG_LEVEL=INFO
# 允许的 CORS 源 (逗号分隔)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
