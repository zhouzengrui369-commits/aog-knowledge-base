# AOG AI 知识库 · Backend 环境变量模板
# 复制为 .env 并填入实际值；.env 已在 .gitignore

# ===== LLM (MiniMax M3) =====
# 必填. 缺失时后端会降级为 Mock LLM (带 "⚠️ Mock 模式" 标志)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.MiniMax.chat/v1
MINIMAX_MODEL=minimax-m3

# ★ P0-4: Mock 隔离 (Owner 7/29 授权)
# dev (本地):  ALLOW_MOCK=true (允许 MockLLM 跑测试, key 空也能起)
# production: ALLOW_MOCK=false (禁 Mock, key 空 fail-closed 容器重启)
# 严格模式:    STRICT_LLM=true (production 必开, LLM 失败 503 不降级 mock)
ALLOW_MOCK=true
STRICT_LLM=false

# ===== 存储 =====
# 向量库 (Chroma 持久化目录)
CHROMA_PATH=./data/chroma
# 元数据 (SQLite 数据库文件)
SQLITE_PATH=./data/aog.db
# FTS5 索引 (D-038 trigram, P0-3 加 build_manifest)
FTS5_PATH=./data/fts5_index.db
# RAG backend: "chroma" (dev 旧) | "fts5" (D-038 治本, 生产)
RAG_BACKEND=fts5

# ===== 知识库源 (只读) =====
# 城市预案 / 经验 / 核心预案根目录
KNOWLEDGE_BASE_PATH=/Users/njx/Project/AOG知识库/AOG知识库
# 原始文件下载代理源
RAW_PATH=/Users/njx/Project/AOG知识库/RAW

# ===== 运行时 =====
# 文件同步间隔 (秒)
SYNC_INTERVAL_S=300
# 日志级别
LOG_LEVEL=INFO
# 允许的 CORS 源 (逗号分隔)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
