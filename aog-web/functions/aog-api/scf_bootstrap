#!/bin/bash
# AOG API - SCF Web Function 启动脚本
# SCF 平台调用此脚本启动 uvicorn 监听 9000 端口 (SCF HTTP 函数标准)
# 依赖: requirements.txt 由 cloudbaserc.json installDependency=true 在平台自动 pip install

set -e
exec /var/lang/python311/bin/python3.11 -m uvicorn aog_web.main:app --host 0.0.0.0 --port 9000 --log-level info
